# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/

# Node / frontend
node_modules/
dist/
build/
word-addin/node_modules/
word-addin/dist/

# Secrets & local config — NEVER commit
.env
.env.*
deploy/.deploy-tokens
*.lock

# Runtime state / generated artifacts
state/
out/

# OS
.DS_Store

# Host-specific deploy config — never commit.
deploy/deploy.env
deploy/compose.yml

# Generated by deploy/deploy.sh to stamp the running build.
src/cra/_build.py

# The design handoff as downloaded — the zip and the folder it unpacked into.
# Kept out so the build stamp does not read "dirty" on every deploy.
/Design/

# Agent working state: machine-local approvals and worktrees, neither of which
# belongs to the project. A rule that matters belongs with the thing it
# protects rather than in one machine's global ignore file.
.claude/

# Working notes that are not part of the project.
private/

# Operator orientation. Written for whoever runs this rather than for whoever
# reads it, and it accumulates exactly the material that does not belong in a
# public tree: deployment topology, what is configured where, and the reasoning
# behind commercial decisions. Four audits found roughly half their material in
# this one file. README.md and CONTRIBUTING.md are the ones written to be read.
CLAUDE.md
