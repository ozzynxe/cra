# Local deploy settings — copy to `deploy/deploy.env` and fill in.
# Sourced by `deploy/deploy.sh`, and by the snippets in
# the deploy scripts, which would otherwise have to name the estate in prose.
#
# None of this is a credential. It is gitignored anyway, so that this
# repository can be published without shipping a map of where things run —
# an account id and an instance name are only useful to someone who already
# has a way in, which is exactly the escalation worth not helping.

# --- what deploy.sh needs -----------------------------------------------------
CRA_HOST_IP=                     # the Lightsail instance's public address
CRA_SSH_KEY=/tmp/cra-ssh/key     # fetched per session, not a stored key
CRA_DOMAIN=cra.skarp.app
CRA_REMOTE_DIR=/home/ubuntu/cra

# Ride a multiplexed master connection rather than authenticating per command.
# Lightsail's issued certificate lasts ~13 minutes; a cold build takes longer,
# so a deploy that re-authenticates per step dies halfway through.
CRA_SSH_OPTS="-o ControlPath=/tmp/cra-ssh/ctl.sock"

# --- named by the runbooks, not by deploy.sh ----------------------------------
CRA_LIGHTSAIL_INSTANCE=          # `aws lightsail get-instance-access-details --instance-name`
CRA_BACKUP_BUCKET=               # the Object Lock archive; substituted into the IAM template
CRA_BACKUP_DR_BUCKET=            # nightly dumps, 90-day lifecycle, no Object Lock
CRA_STATUTORY_BUCKET=            # the Object Lock archive the app exports to;
                                 # read by scripts/prune_test_archive.py
CRA_DB_SUPERUSER=                # NOT `postgres` — every `-U postgres` snippet will fail
CRA_ROUTE53_ZONE_ID=             # the hosted zone for CRA_DOMAIN
