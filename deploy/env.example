# Copy to /home/ubuntu/cra/.env on the host, fill in, chmod 600.
#
# NEVER commit or rsync this file. `deploy.sh` excludes it; `.gitignore` covers
# it. Prod loads it via compose `env_file:`.
#
# Compose reads env_file at container *creation*, not restart. After editing
# this, `docker compose up -d --force-recreate cra` — a plain `restart` keeps
# the old values and you will debug the wrong thing for an hour.

# ---- database ---------------------------------------------------------------
# Its own database and its own role. Not shared with any other app on the box:
# a credential compromise elsewhere must not reach unreported vulnerability
# details.
#
# `bootstrap.sh` writes the real DATABASE_URL into the host .env itself, with a
# generated password it never prints. It is deliberately left commented here so
# that appending this file to an already-bootstrapped .env cannot shadow it —
# a second DATABASE_URL line would win and point at the wrong password.
#
# DATABASE_URL=postgresql+psycopg://cra_app:CHANGE_ME@deploy-postgres-1:5432/cra

# ---- identity ---------------------------------------------------------------
CRA_ENV=production
CRA_STORE=pg
CRA_LOG_LEVEL=info
CRA_ALLOWED_HOSTS=cra.example.app
CRA_APP_ORIGIN=https://cra.example.app
CRA_CORS_ORIGINS=https://cra.example.app

# Admin endpoints (/admin/*). 32+ random bytes; `openssl rand -hex 32`.
CRA_ADMIN_TOKEN=CHANGE_ME

# The legacy two-party demo mounts. Leave unset in production — they are kept
# for the POC tests only, carry a party id rather than a user id, and cannot
# write anything against Postgres.
# CRA_TOKEN_A=
# CRA_TOKEN_B=

# ---- deadline alerting ------------------------------------------------------
# ON by default in code. Set to 0 only as a deliberate decision — a deploy that
# silently stops chasing statutory deadlines is the failure this exists to
# prevent.
CRA_DEADLINE_ALERTS_ENABLED=1
CRA_ALERTS_FROM=cra-alerts@example.app
CRA_ALERTS_SES_REGION=eu-north-1
CRA_SWEEP_INTERVAL_SECONDS=300

# SES send credentials. Scope the IAM user to ses:SendEmail on the verified
# identity and nothing else.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-north-1

# ---- observability ----------------------------------------------------------
# Both optional, and empty here on purpose.
#
# With SENTRY_DSN empty there is no error tracking: `_init_sentry()` is a no-op
# and errors reach the container log and nowhere else. Worth knowing before
# assuming a crash was captured somewhere — and whichever way this is set, it
# has to match /privacy.html, which names the processors that receive data.
#
# CRA_RELEASE only labels errors for whichever tracker the DSN points at. Leave
# it unset: the release then falls back to the commit `deploy.sh` stamped into
# the image, so it is correct without anyone maintaining it. A value set here
# that no longer matches the deployed commit is reported by /version as
# `release_stale`, because a hand-edited label rots silently otherwise.
SENTRY_DSN=
CRA_RELEASE=

# ---- rate limiting ----------------------------------------------------------
# Redis-backed, fails open if unreachable.
REDIS_URL=redis://deploy-redis-1:6379/3

# ---- proactive advisory scanning --------------------------------------------
# Checks each product's SBOM against OSV and CISA KEV, and mails the members
# when a component they ship carries an actively exploited vulnerability.
#
# This is the only feature that sends anything off this host: package name,
# ecosystem and version per component, to api.osv.dev. Never the SBOM document,
# the product name, or anything about your vulnerabilities. The KEV catalogue is
# downloaded whole and matched locally. /privacy.html describes exactly this —
# if you change the behaviour, change the page.
#
# Set to 0 and nothing leaves the host; you also get no proactive warnings.
CRA_ADVISORY_SCAN_ENABLED=1
CRA_ADVISORY_ALERTS_ENABLED=1
CRA_ADVISORY_SWEEP_SECONDS=86400

# ---- Plans and billing -------------------------------------------------------
# 1 enforces plan limits; 0 is shadow mode, where every gate logs what it would
# have blocked and lets the call through. Shadow mode is the code default so a
# misconfigured gate cannot lock anyone out of compliance work — bring a new
# deployment up in it, read a day of `entitlements(shadow)` lines, then set 1.
#
# `docker compose restart` will NOT pick up a change here: compose reads
# env_file at container creation, so use
# `docker compose up -d --force-recreate cra`.
CRA_ENTITLEMENTS_ENFORCED=0

# Per-plan limits, if the defaults in server/entitlements.py need moving without
# a deploy. CRA_PLAN_<PLAN>_MAX_PRODUCTS / _MAX_MEMBERS.
# CRA_PLAN_TEAM_MAX_PRODUCTS=3

# Stripe. Without all of these, `get_upgrade_link` says checkout is unavailable
# and points at the operator rather than failing — so a half-configured
# deployment is inert, not broken.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# One price per (plan, cadence). A plan with no price configured is simply not
# offered for sale — this is the list, there is no other. Prices themselves live
# in Stripe; nothing in this repo states an amount.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PORTFOLIO_MONTHLY=
STRIPE_PRICE_PORTFOLIO_ANNUAL=
